{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["package.json", "pnpm-lock.yaml", "tsconfig.base.json"],
  "globalEnv": ["NODE_ENV", "VITE_*", "WAILS"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "lint:strict": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "type-check": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "type-check:watch": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["coverage/**"]
    },
    "test:coverage": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    },
    "@lumina/backend#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "prisma/schema/**",
        "package.json",
        "tsconfig.json",
        "nest-cli.json",
        "prisma.config.*"
      ],
      "outputs": ["dist/**"]
    },
    "@lumina/backend#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "inputs": [
        "src/**",
        "prisma/schema/**",
        "package.json",
        "tsconfig.json",
        "nest-cli.json",
        "prisma.config.*",
        "vitest.config.*",
        ".env*"
      ]
    },
    "@lumina/frontend#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "public/**",
        "package.json",
        "tsconfig.json",
        "vite.config.*",
        "postcss.config.*",
        "tailwind.config.*",
        "pwa-assets.config.ts",
        ".env*",
        "!android/**",
        "!ios/**"
      ],
      "outputs": ["dist/**"]
    },
    "@lumina/frontend#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "inputs": [
        "src/**",
        "public/**",
        "package.json",
        "tsconfig.json",
        "vite.config.*",
        "postcss.config.*",
        "tailwind.config.*",
        "capacitor.config.ts",
        ".env*",
        "!android/**",
        "!ios/**"
      ]
    },
    "@lumina/frontend#lint": {
      "inputs": [
        "src/**",
        "tests/**",
        "package.json",
        "tsconfig.json",
        "eslint.config.*",
        "eslint.strict.config.*",
        "!android/**",
        "!ios/**"
      ]
    },
    "@lumina/frontend#lint:strict": {
      "inputs": [
        "src/**",
        "tests/**",
        "package.json",
        "tsconfig.json",
        "eslint.config.*",
        "eslint.strict.config.*",
        "!android/**",
        "!ios/**"
      ]
    },
    "@lumina/frontend#type-check": {
      "inputs": [
        "src/**",
        "tests/**",
        "package.json",
        "tsconfig.json",
        "vite.config.*",
        "vitest.config.*",
        "!android/**",
        "!ios/**"
      ]
    },
    "@lumina/frontend#type-check:watch": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "inputs": [
        "src/**",
        "tests/**",
        "package.json",
        "tsconfig.json",
        "vite.config.*",
        "vitest.config.*",
        "!android/**",
        "!ios/**"
      ]
    },
    "@lumina/frontend#test": {
      "inputs": [
        "src/**",
        "tests/**",
        "package.json",
        "tsconfig.json",
        "vitest.config.*",
        "!android/**",
        "!ios/**"
      ],
      "outputs": ["coverage/**"]
    },
    "@lumina/shared#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "package.json", "tsconfig.json", "tsup.config.*"],
      "outputs": ["dist/**"]
    },
    "@lumina/shared#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "inputs": ["src/**", "package.json", "tsconfig.json", "tsup.config.*"]
    },
    "@lumina/shared#type-check:watch": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "inputs": ["src/**", "package.json", "tsconfig.json", "tsup.config.*"]
    },
    "@lumina/backend#type-check:watch": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "inputs": [
        "src/**",
        "tests/**",
        "prisma/schema/**",
        "package.json",
        "tsconfig.json",
        "nest-cli.json",
        "prisma.config.*",
        "vitest.config.*"
      ]
    },
    "@lumina/sidecar#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "package.json", "tsconfig.json", "tsup.config.*"],
      "outputs": ["dist/**"]
    },
    "@lumina/sidecar#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "inputs": ["src/**", "package.json", "tsconfig.json", "tsup.config.*"]
    },
    "@lumina/sidecar#type-check": {
      "inputs": ["src/**", "package.json", "tsconfig.json"]
    },
    "@lumina/sidecar#test": {
      "inputs": ["src/**", "tests/**", "package.json", "tsconfig.json", "vitest.config.*"],
      "outputs": ["coverage/**"]
    }
  }
}

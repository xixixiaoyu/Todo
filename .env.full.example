# ==============================================================================
# 应用环境配置模板（完整但精简）
# ==============================================================================
# 复制此文件为 .env 并按环境修改。

# ------------------------------------------------------------------------------
# 1) 后端基础（建议保留）
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 2) 数据库与缓存（核心）
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lumina
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lumina?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dev-redis-password
REDIS_DB=0
REDIS_KEY_PREFIX=lumina:
REDIS_DEFAULT_TTL=300

# ------------------------------------------------------------------------------
# 3) 认证与安全（核心）
# ------------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
RESET_PASSWORD_EXPIRES_IN=3600

# 限流
THROTTLE_SHORT_TTL=1000
THROTTLE_SHORT_LIMIT=3
THROTTLE_MEDIUM_TTL=10000
THROTTLE_MEDIUM_LIMIT=20
THROTTLE_LONG_TTL=60000
THROTTLE_LONG_LIMIT=100

# 上传
UPLOAD_MAX_SIZE=10485760
UPLOAD_MAX_FILES=10

# ------------------------------------------------------------------------------
# 4) 可选外部服务（按需启用）
# ------------------------------------------------------------------------------
# SMTP
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="No Reply <noreply@example.com>"

# S3 / OSS / MinIO
S3_BUCKET=lumina-uploads
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 5) 前端构建/开发覆盖（按需）
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000/api
# VITE_PROXY_TARGET=http://localhost:3000
# VITE_BASE_URL=/
# VITE_PWA_DEV=false
# WAILS=true

# ------------------------------------------------------------------------------
# 6) Docker 生产部署（deploy.sh / docker-compose）
# ------------------------------------------------------------------------------
IMAGE_TAG=prod
# BACKEND_IMAGE_TAG=backend-prod
# FRONTEND_IMAGE_TAG=frontend-prod
# VCS_REF=unknown

GOACCESS_REPORT_PORT=7890
GOACCESS_REPORT_BIND=127.0.0.1

NPM_HTTP_BIND=0.0.0.0
NPM_HTTPS_BIND=0.0.0.0
NPM_ADMIN_BIND=127.0.0.1
NPM_ADMIN_PORT=81

# ------------------------------------------------------------------------------
# 7) 部署脚本高级参数（按需）
# ------------------------------------------------------------------------------
# DEPLOY_LOCK_DIR=/tmp/lumina-deploy.lock
# GIT_REMOTE=origin
# GIT_BRANCH=main
# DISK_WARN_THRESHOLD=80
# DISK_CRITICAL_THRESHOLD=90
# DISK_ABORT_THRESHOLD=95
# ALERT_WARN_THRESHOLD=85
# ALERT_CRITICAL_THRESHOLD=90
# IMAGE_PRUNE_UNTIL=240h
# BUILDER_PRUNE_UNTIL=168h
# ENABLE_AGGRESSIVE_PRUNE=false
# DOCKER_DF_VERBOSE=false
# DOCKER_BUILDKIT=1
# COMPOSE_DOCKER_CLI_BUILD=1

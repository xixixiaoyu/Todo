{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "paths": {
      "@/*": ["./src/*"],
      "@my-app/shared": ["../../packages/shared/src/index.ts"]
    },
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "vite.config.mts",
    "vitest.config.mts",
    "capacitor.config.ts",
    "pwa-assets.config.ts",
    "tests/**/*.ts",
    "tests/**/*.vue"
  ],
  "exclude": ["node_modules", "dist"]
}

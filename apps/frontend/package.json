{
  "name": "@lumina/frontend",
  "version": "1.0.0-beta.8",
  "description": "简思 (Lumina) — 简于形，深于思的高效纯粹 AI 个人待办应用",
  "author": "牧云 (Mu Yun) <yunmucoder@163.com>",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vite",
    "type-check": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vue-tsc --noEmit -p tsconfig.json",
    "type-check:watch": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vue-tsc --noEmit -p tsconfig.json --watch --preserveWatchOutput",
    "build": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vite build",
    "preview": "vite preview",
    "lint": "cross-env NODE_OPTIONS='--max-old-space-size=8192' eslint . --cache",
    "lint:fix": "cross-env NODE_OPTIONS='--max-old-space-size=8192' eslint . --fix --cache",
    "clean": "shx rm -rf dist",
    "test": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cap:sync": "cap sync",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "cap:run:ios": "cap run ios",
    "cap:run:android": "cap run android",
    "cap:build": "pnpm build && cap sync",
    "pwa:generate-icons": "pwa-assets-generator",
    "build:wails": "cross-env WAILS=true pnpm build && shx rm -rf ../wails/frontend/dist && shx mkdir -p ../wails/frontend/dist && shx cp -r dist/* ../wails/frontend/dist/"
  },
  "dependencies": {
    "@capacitor/android": "8.0.0",
    "@capacitor/core": "8.0.0",
    "@capacitor/haptics": "8.0.0",
    "@capacitor/ios": "8.0.0",
    "@iktakahiro/markdown-it-katex": "4.0.1",
    "@lumina/shared": "workspace:*",
    "@tanstack/vue-query": "5.92.1",
    "@types/three": "0.183.1",
    "@vee-validate/zod": "4.15.1",
    "@vueuse/core": "14.1.0",
    "axios": "1.13.5",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dayjs": "1.11.19",
    "dompurify": "3.3.3",
    "echarts": "6.0.0",
    "gsap": "3.14.2",
    "highlight.js": "11.11.1",
    "katex": "0.16.27",
    "lodash-es": "4.17.23",
    "lucide-vue-next": "0.562.0",
    "markdown-it": "14.1.1",
    "markdown-it-highlightjs": "4.2.0",
    "mermaid": "11.12.2",
    "pinia": "3.0.4",
    "pinia-plugin-persistedstate": "4.7.1",
    "reka-ui": "2.7.0",
    "socket.io-client": "4.8.3",
    "tailwind-merge": "3.4.0",
    "three": "0.183.2",
    "vee-validate": "4.15.1",
    "vue": "3.5.26",
    "vue-echarts": "8.0.1",
    "vue-i18n": "11.2.7",
    "vue-router": "4.6.4",
    "vuedraggable": "4.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "8.0.0",
    "@tailwindcss/postcss": "4.1.18",
    "@types/canvas-confetti": "1.9.0",
    "@types/dompurify": "3.2.0",
    "@types/lodash-es": "4.17.12",
    "@types/markdown-it": "14.1.2",
    "@types/node": "25.0.3",
    "@vite-pwa/assets-generator": "1.0.2",
    "@vitejs/plugin-vue": "6.0.5",
    "@vitest/coverage-v8": "4.1.0",
    "@vue/test-utils": "2.4.6",
    "autoprefixer": "10.4.23",
    "cross-env": "10.1.0",
    "eslint": "9.39.2",
    "eslint-plugin-vue": "10.6.2",
    "globals": "16.5.0",
    "happy-dom": "20.0.11",
    "postcss": "8.5.6",
    "postcss-import": "16.1.0",
    "shx": "0.3.4",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.1",
    "vite": "8.0.0",
    "vite-plugin-compression": "0.5.1",
    "vite-plugin-pwa": "1.2.0",
    "vitest": "4.1.0",
    "vue-eslint-parser": "10.2.0",
    "vue-tsc": "3.2.1"
  }
}

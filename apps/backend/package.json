{
  "name": "@my-app/backend",
  "version": "1.0.0-beta.1",
  "private": true,
  "scripts": {
    "build": "cross-env NODE_OPTIONS='--max-old-space-size=8192' nest build",
    "type-check": "cross-env NODE_OPTIONS='--max-old-space-size=8192' tsc --noEmit",
    "dev": "cross-env NODE_OPTIONS='--max-old-space-size=8192' ts-node-dev --respawn --transpile-only src/main.ts",
    "start": "node dist/src/main.js",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "pm2:start": "pm2 start ../../ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ../../ecosystem.config.js",
    "pm2:restart": "pm2 restart ../../ecosystem.config.js",
    "pm2:logs": "pm2 logs todo-backend",
    "lint": "cross-env NODE_OPTIONS='--max-old-space-size=8192' eslint . --cache",
    "lint:fix": "cross-env NODE_OPTIONS='--max-old-space-size=8192' eslint . --fix --cache",
    "clean": "rm -rf dist",
    "test": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.958.0",
    "@aws-sdk/s3-request-presigner": "3.958.0",
    "@fastify/compress": "8.3.1",
    "@fastify/cookie": "10.0.1",
    "@fastify/cors": "11.2.0",
    "@fastify/helmet": "13.0.0",
    "@fastify/multipart": "9.4.0",
    "@fastify/static": "8.0.0",
    "@modelcontextprotocol/sdk": "1.26.0",
    "@my-app/shared": "workspace:*",
    "@nestjs-modules/mailer": "2.0.2",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/cache-manager": "3.1.0",
    "@nestjs/common": "11.1.10",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.10",
    "@nestjs/event-emitter": "3.0.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-fastify": "11.1.10",
    "@nestjs/platform-socket.io": "11.1.10",
    "@nestjs/swagger": "11.2.3",
    "@nestjs/terminus": "11.0.0",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/websockets": "11.1.10",
    "@prisma/adapter-pg": "7.2.0",
    "@prisma/client": "7.2.0",
    "@simplewebauthn/server": "13.2.2",
    "@types/pdf-parse": "1.1.5",
    "bcryptjs": "3.0.3",
    "bullmq": "5.66.3",
    "cache-manager": "7.2.7",
    "cache-manager-ioredis-yet": "2.1.2",
    "dayjs": "1.11.19",
    "dotenv": "17.2.3",
    "fastify": "5.7.4",
    "ioredis": "5.8.2",
    "lodash": "4.17.21",
    "mammoth": "1.11.0",
    "nestjs-i18n": "10.6.0",
    "nestjs-pino": "4.5.0",
    "nestjs-zod": "5.0.1",
    "nodemailer": "7.0.12",
    "passport": "0.7.0",
    "passport-google-oauth20": "2.0.0",
    "passport-jwt": "4.0.1",
    "pdf-parse": "2.4.5",
    "pg": "8.16.3",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "prisma": "7.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.17.0",
    "socket.io": "4.8.3",
    "xlsx": "0.18.5",
    "xss": "1.0.15"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.14",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.10",
    "@types/bcryptjs": "3.0.0",
    "@types/lodash": "4.17.21",
    "@types/node": "25.0.3",
    "@types/nodemailer": "7.0.4",
    "@types/passport-google-oauth20": "2.0.17",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.16.0",
    "@types/sanitize-html": "2.16.0",
    "@vitest/coverage-v8": "4.0.16",
    "cross-env": "10.1.0",
    "eslint": "9.39.2",
    "ts-loader": "9.5.4",
    "ts-node-dev": "2.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.1",
    "vitest": "4.0.16"
  }

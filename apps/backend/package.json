{
  "name": "@my-app/backend",
  "version": "1.0.0-beta.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "type-check": "tsc --noEmit",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start": "node dist/src/main.js",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "pm2:start": "pm2 start ../../ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ../../ecosystem.config.js",
    "pm2:restart": "pm2 restart ../../ecosystem.config.js",
    "pm2:logs": "pm2 logs todo-backend",
    "lint": "cross-env NODE_OPTIONS='--max-old-space-size=4096' eslint . --fix --cache",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:switch": "node scripts/switch-db.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.980.0",
    "@aws-sdk/s3-request-presigner": "3.980.0",
    "@my-app/shared": "workspace:*",
    "@nestjs-modules/mailer": "2.0.2",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/cache-manager": "3.1.0",
    "@nestjs/common": "11.1.12",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.12",
    "@nestjs/event-emitter": "3.0.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.12",
    "@nestjs/platform-socket.io": "11.1.12",
    "@nestjs/swagger": "11.2.5",
    "@nestjs/terminus": "11.0.0",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/websockets": "11.1.12",
    "@prisma/adapter-better-sqlite3": "7.3.0",
    "@prisma/adapter-pg": "7.3.0",
    "@prisma/client": "7.3.0",
    "@simplewebauthn/server": "13.2.2",
    "@types/pdf-parse": "^1.1.5",
    "bcryptjs": "3.0.3",
    "better-sqlite3": "12.6.2",
    "bullmq": "5.67.2",
    "cache-manager": "7.2.8",
    "cache-manager-ioredis-yet": "2.1.2",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "dayjs": "1.11.19",
    "dotenv": "17.2.3",
    "helmet": "8.1.0",
    "ioredis": "5.9.2",
    "lodash": "4.17.23",
    "mammoth": "^1.11.0",
    "multer": "2.0.2",
    "nestjs-i18n": "10.6.0",
    "nestjs-pino": "4.5.0",
    "nestjs-zod": "5.1.1",
    "nodemailer": "7.0.13",
    "passport": "0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "4.0.1",
    "pdf-parse": "^2.4.5",
    "pg": "8.18.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "prisma": "7.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.17.0",

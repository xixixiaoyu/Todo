{
  "name": "@lumina/backend",
  "version": "1.0.0-beta.8",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "牧云 (Mu Yun) <yunmucoder@163.com>",
  "scripts": {
    "build": "nest build",
    "type-check": "tsgo --noEmit",
    "type-check:watch": "tsgo --noEmit --watch",
    "dev": "bun --watch src/main.ts",
    "start": "node dist/apps/backend/src/main.js",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/backend/src/main.js",
    "pm2:start": "pm2 start ../../ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ../../ecosystem.config.js",
    "pm2:restart": "pm2 restart ../../ecosystem.config.js",
    "pm2:logs": "pm2 logs todo-backend",
    "lint": "eslint src tests '*.{js,mjs,cjs,ts,mts,cts}' --cache --cache-location .eslintcache-fast --cache-strategy content --no-warn-ignored",
    "lint:strict": "eslint src tests '*.{js,mjs,cjs,ts,mts,cts}' --config eslint.strict.config.mjs --cache --cache-location .eslintcache-strict --cache-strategy content --no-warn-ignored",
    "lint:fix": "eslint src tests '*.{js,mjs,cjs,ts,mts,cts}' --fix --cache --cache-location .eslintcache-fast --cache-strategy content --no-warn-ignored",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.958.0",

{
  "name": "@lumina/backend",
  "version": "1.0.0-beta.8",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "牧云 (Mu Yun) <yunmucoder@163.com>",
  "scripts": {
    "build": "cross-env NODE_OPTIONS='--max-old-space-size=8192' nest build",
    "type-check": "cross-env NODE_OPTIONS='--max-old-space-size=8192' tsc --noEmit",
    "type-check:watch": "cross-env NODE_OPTIONS='--max-old-space-size=8192' tsc --noEmit --watch --preserveWatchOutput",
    "dev": "cross-env NODE_OPTIONS='--max-old-space-size=8192' node --watch -r ts-node/register/transpile-only src/main.ts",
    "start": "node dist/apps/backend/src/main.js",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/backend/src/main.js",
    "pm2:start": "pm2 start ../../ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ../../ecosystem.config.js",
    "pm2:restart": "pm2 restart ../../ecosystem.config.js",
    "pm2:logs": "pm2 logs todo-backend",
    "lint": "cross-env NODE_OPTIONS='--max-old-space-size=8192' eslint src tests '*.{js,mjs,cjs,ts,mts,cts}' --cache --cache-location .eslintcache-fast --cache-strategy content --no-warn-ignored",
    "lint:strict": "cross-env NODE_OPTIONS='--max-old-space-size=8192' eslint src tests '*.{js,mjs,cjs,ts,mts,cts}' --config eslint.strict.config.mjs --cache --cache-location .eslintcache-strict --cache-strategy content --no-warn-ignored",
    "lint:fix": "cross-env NODE_OPTIONS='--max-old-space-size=8192' eslint src tests '*.{js,mjs,cjs,ts,mts,cts}' --fix --cache --cache-location .eslintcache-fast --cache-strategy content --no-warn-ignored",
    "clean": "rm -rf dist",
    "test": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1022.0",
    "@aws-sdk/s3-request-presigner": "3.1022.0",
    "@fastify/compress": "8.3.1",
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.2.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/multipart": "9.4.0",
    "@fastify/static": "9.0.0",
    "@lumina/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/cache-manager": "3.1.0",
    "@nestjs/common": "11.1.17",
    "@nestjs/config": "4.0.3",
    "@nestjs/core": "11.1.17",
    "@nestjs/event-emitter": "3.0.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.17",
    "@nestjs/platform-fastify": "11.1.17",
    "@nestjs/platform-socket.io": "11.1.17",
    "@nestjs/swagger": "11.2.6",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/websockets": "11.1.17",
    "@prisma/adapter-pg": "7.6.0",
    "@prisma/client": "7.6.0",
    "@types/pdf-parse": "1.1.5",
    "bcryptjs": "3.0.3",
    "bullmq": "5.72.0",
    "cache-manager": "7.2.8",
    "cache-manager-ioredis-yet": "2.1.2",
    "dayjs": "1.11.20",
    "dotenv": "17.3.1",
    "exceljs": "4.4.0",
    "fastify": "5.8.4",
    "ioredis": "5.10.1",
    "lodash": "4.17.21",
    "mammoth": "1.12.0",
    "nestjs-i18n": "10.6.0",
    "nestjs-pino": "4.6.1",
    "nestjs-zod": "5.2.1",
    "nodemailer": "8.0.4",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pdf-parse": "2.4.5",
    "pg": "8.20.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "prisma": "7.6.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.17.2",
    "socket.io": "4.8.3",
    "xss": "1.0.15"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.17",
    "@nestjs/schematics": "11.0.10",
    "@nestjs/testing": "11.1.17",
    "@types/bcryptjs": "3.0.0",
    "@types/lodash": "4.17.24",
    "@types/node": "25.5.0",
    "@types/nodemailer": "7.0.4",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.20.0",
    "@types/sanitize-html": "2.16.1",
    "@vitest/coverage-v8": "4.1.2",
    "cross-env": "10.1.0",
    "eslint": "10.1.0",
    "ts-loader": "9.5.4",
    "ts-node-dev": "2.0.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.58.0",
    "vitest": "4.1.2"
  }
}

model McpServer {
  id          String   @id @default(uuid())
  name        String
  description String?
  transport   String
  config      Json
  enabled     Boolean  @default(true)
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mcp_servers")
}

model LearningProgress {
  id           String   @id @default(uuid())
  concept      String
  masteryLevel String   @default("novice")
  lastQuizAt   DateTime @default(now())
  quizCount    Int      @default(0)
  correctCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([concept])
  @@map("learning_progress")
}

model QuizRecord {
  id         String   @id @default(uuid())
  quizId     String
  stem       String
  kind       String
  userAnswer Json
  result     String
  mastery    String
  feedback   String
  nextFocus  String?
  createdAt  DateTime @default(now())

  @@map("quiz_records")
}

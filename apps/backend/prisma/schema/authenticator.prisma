model Authenticator {
    id                   String   @id
    credentialID         Bytes    @unique
    credentialPublicKey  Bytes
    counter              BigInt
    credentialDeviceType String
    credentialBackedUp   Boolean
    transports           String?
    name                 String?
    userId               Int
    user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    createdAt            DateTime @default(now())

    @@map("authenticators")
}

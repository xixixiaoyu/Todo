model User {
  id                   Int             @id @default(autoincrement())
  email                String          @unique
  name                 String
  password             String?
  avatar               String?
  googleId             String?         @unique
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  mcpServers           McpServer[]
  todos                Todo[]

  @@map("users")
}

{
  "name": "@lumina/shared",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "牧云 (Mu Yun)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "type-check": "tsgo --noEmit",
    "type-check:watch": "tsgo --noEmit --watch",
    "dev": "TSUP_DEV=true tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src '*.{js,mjs,cjs,ts,mts,cts}' --cache --cache-location .eslintcache-fast --cache-strategy content --no-warn-ignored",
    "lint:strict": "eslint src '*.{js,mjs,cjs,ts,mts,cts}' --config eslint.strict.config.mjs --cache --cache-location .eslintcache-strict --cache-strategy content --no-warn-ignored",
    "lint:fix": "eslint src '*.{js,mjs,cjs,ts,mts,cts}' --fix --cache --cache-location .eslintcache-fast --cache-strategy content --no-warn-ignored",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}

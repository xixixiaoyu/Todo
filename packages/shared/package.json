{
  "name": "@lumina/shared",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "牧云 (Mu Yun)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "cross-env NODE_OPTIONS='--max-old-space-size=8192' tsup",
    "type-check": "cross-env NODE_OPTIONS='--max-old-space-size=8192' tsc --noEmit",
    "type-check:watch": "cross-env NODE_OPTIONS='--max-old-space-size=8192' tsc --noEmit --watch --preserveWatchOutput",
    "dev": "cross-env NODE_OPTIONS='--max-old-space-size=8192' tsup --watch",
    "test": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "cross-env NODE_OPTIONS='--max-old-space-size=8192' eslint . --cache",
    "lint:fix": "cross-env NODE_OPTIONS='--max-old-space-size=8192' eslint . --fix --cache",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.0",
    "cross-env": "10.1.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}

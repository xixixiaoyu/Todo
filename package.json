{
  "name": "my-app",
  "version": "1.0.0-beta.1",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "type-check": "turbo run type-check",
    "lint": "cross-env NODE_OPTIONS='--max-old-space-size=4096' turbo run lint",
    "lint:fix": "cross-env NODE_OPTIONS='--max-old-space-size=4096' turbo run lint -- --fix --cache",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security-audit": "node scripts/security-audit.js",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @my-app/backend prisma:generate",
    "db:push": "pnpm --filter @my-app/backend prisma:push",
    "db:migrate": "pnpm --filter @my-app/backend prisma:migrate",
    "db:studio": "pnpm --filter @my-app/backend prisma:studio",
    "prepare": "husky",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:clean": "docker compose down -v --rmi local",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:restart": "docker compose -f docker-compose.dev.yml restart backend frontend",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "docker:dev:ps": "docker compose -f docker-compose.dev.yml ps",
    "docker:dev:clean": "docker compose -f docker-compose.dev.yml down -v --rmi local",
    "wails:dev": "cd apps/wails && wails dev",
    "wails:build": "cd apps/wails && wails build -trimpath -clean -ldflags \"-s -w\"",
    "wails:kill": "./scripts/close-app.sh",
    "wails:install": "./scripts/deploy-app.sh",
    "wails:deploy": "pnpm wails:kill && pnpm wails:build && pnpm wails:install",
    "tag:refresh": "./scripts/refresh-tag.sh"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "cross-env": "10.1.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-vue": "10.6.2",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "prettier": "3.7.4",
    "turbo": "2.7.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.1",
    "vitest": "4.0.16",
    "@vitest/coverage-v8": "4.0.16"
  },
  "lint-staged": {
    "apps/frontend/**/*.{ts,tsx,vue}": [
      "cross-env NODE_OPTIONS='--max-old-space-size=4096' eslint --fix --cache --config apps/frontend/eslint.config.mjs"
    ],
    "apps/backend/**/*.ts": [
      "cross-env NODE_OPTIONS='--max-old-space-size=4096' eslint --fix --cache --config apps/backend/eslint.config.mjs"
    ],
    "packages/shared/**/*.ts": [
      "cross-env NODE_OPTIONS='--max-old-space-size=4096' eslint --fix --cache --config packages/shared/eslint.config.mjs"
    ],
    "**/*.{json,css,scss,html,yml,yaml,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "nodemailer": "7.0.12",
      "glob": "10.5.0",
      "qs": "6.14.1",
      "tar": "7.5.3",
      "diff": "8.0.3",
      "hono": "4.11.4",
      "katex": "0.16.21"
    }
  }
}

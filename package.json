{
  "name": "lumina",
  "version": "1.0.0-beta.9",
  "description": "Lumina (简思) - An AI-driven personal todo system with extreme interactive experience and rigorous engineering practices.",
  "license": "AGPL-3.0-only",
  "author": "牧云 (Mu Yun) <yunmucoder@163.com>",
  "homepage": "https://github.com/xixixiaoyu/lumina",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xixixiaoyu/lumina.git"
  },
  "bugs": {
    "url": "https://github.com/xixixiaoyu/lumina/issues"
  },
  "keywords": [
    "todo",
    "ai",
    "mcp",
    "nestjs",
    "vue",
    "wails",
    "capacitor",
    "monorepo",
    "productivity"
  ],
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS='--max-old-space-size=8192' turbo run dev --filter=@lumina/shared --filter=@lumina/backend --filter=@lumina/frontend",
    "dev:backend": "cross-env NODE_OPTIONS='--max-old-space-size=8192' turbo run dev --filter=@lumina/shared --filter=@lumina/backend",
    "dev:frontend": "cross-env NODE_OPTIONS='--max-old-space-size=8192' turbo run dev --filter=@lumina/shared --filter=@lumina/frontend",
    "dev:all": "cross-env NODE_OPTIONS='--max-old-space-size=8192' turbo run dev",
    "build": "cross-env NODE_OPTIONS='--max-old-space-size=8192' turbo run build",
    "build:ci": "cross-env NODE_OPTIONS='--max-old-space-size=8192' turbo run build --concurrency=50%",
    "type-check": "cross-env NODE_OPTIONS='--max-old-space-size=8192' turbo run type-check --concurrency=2",
    "type-check:watch": "cross-env NODE_OPTIONS='--max-old-space-size=8192' turbo run type-check:watch --filter=@lumina/shared --filter=@lumina/backend --filter=@lumina/frontend",
    "lint": "cross-env NODE_OPTIONS='--max-old-space-size=8192' turbo run lint",
    "lint:strict": "cross-env NODE_OPTIONS='--max-old-space-size=8192' turbo run lint:strict",
    "lint:fix": "cross-env NODE_OPTIONS='--max-old-space-size=8192' turbo run lint -- --fix --cache",
    "test": "cross-env NODE_OPTIONS='--max-old-space-size=8192' turbo run test",
    "ci:check": "pnpm format:check && cross-env NODE_OPTIONS='--max-old-space-size=8192' turbo run lint:strict type-check --concurrency=50%",
    "ci:test": "cross-env NODE_OPTIONS='--max-old-space-size=8192' turbo run test --concurrency=50%",
    "ci:all": "pnpm ci:check && pnpm ci:test && pnpm security-audit",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security-audit": "node scripts/security-audit.js",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @lumina/backend prisma:generate",
    "db:push": "pnpm --filter @lumina/backend prisma:push",
    "db:migrate": "pnpm --filter @lumina/backend prisma:migrate",
    "db:studio": "pnpm --filter @lumina/backend prisma:studio",
    "prepare": "husky",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:clean": "docker compose down -v --rmi local",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:restart": "docker compose -f docker-compose.dev.yml restart backend frontend",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "docker:dev:ps": "docker compose -f docker-compose.dev.yml ps",
    "docker:dev:clean": "docker compose -f docker-compose.dev.yml down -v --rmi local",
    "docker:prune": "docker system prune -f --volumes",
    "wails:dev": "cd apps/wails && wails dev",
    "wails:build": "pnpm sidecar:build && cd apps/wails && wails build -trimpath -clean -ldflags \"-s -w\" && ./scripts/assemble-sidecar.sh",
    "wails:kill": "./scripts/close-app.sh",
    "wails:install": "./scripts/deploy-app.sh",
    "wails:deploy": "pnpm wails:kill && pnpm wails:build && pnpm wails:install",
    "sidecar:build": "pnpm --filter @lumina/shared build && pnpm --filter @lumina/sidecar build",
    "sidecar:dev": "pnpm --filter @lumina/shared build && pnpm --filter @lumina/sidecar dev",
    "tag:refresh": "./scripts/refresh-tag.sh",
    "pm2:backend": "pnpm --filter @lumina/backend pm2:start"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@vitest/coverage-v8": "4.1.0",
    "cross-env": "10.1.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-vue": "10.6.2",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "prettier": "3.7.4",
    "turbo": "2.7.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.1",
    "vitest": "4.1.0"
  },
  "lint-staged": {
    "apps/frontend/**/*.{ts,tsx,vue}": [
      "cross-env NODE_OPTIONS='--max-old-space-size=8192' eslint --fix --cache --cache-location apps/frontend/.eslintcache-fast --cache-strategy content --config apps/frontend/eslint.config.mjs",
      "prettier --write"
    ],
    "apps/backend/**/*.ts": [
      "cross-env NODE_OPTIONS='--max-old-space-size=8192' eslint --fix --cache --cache-location apps/backend/.eslintcache-fast --cache-strategy content --config apps/backend/eslint.config.mjs",
      "prettier --write"
    ],
    "packages/shared/**/*.ts": [
      "cross-env NODE_OPTIONS='--max-old-space-size=8192' eslint --fix --cache --cache-location packages/shared/.eslintcache-fast --cache-strategy content --config packages/shared/eslint.config.mjs",
      "prettier --write"
    ],
    "**/*.{json,css,scss,html,yml,yaml,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "nodemailer": "7.0.12",
      "glob": "10.5.0",
      "lodash": "4.17.23",
      "lodash-es": "4.17.23",
      "qs": "6.15.0",
      "tar": "7.5.3",
      "diff": "8.0.3",
      "hono": "4.12.8",
      "@hono/node-server": "1.19.11",
      "@fastify/middie": "9.3.1",
      "express-rate-limit": "8.3.1",
      "file-type": "21.3.2",
      "mailparser": "3.9.4",
      "fastify": "5.8.2",
      "fast-xml-parser": "5.5.9",
      "effect": "3.20.1",
      "liquidjs": "10.25.0",
      "dompurify": "3.3.3",
      "underscore": "1.13.8",
      "socket.io-parser": "4.2.6",
      "minimatch@>=5.0.0 <6.0.0": "5.1.8",
      "minimatch@>=9.0.0 <10.0.0": "9.0.7",
      "katex": "0.16.21"
    }
  }
}

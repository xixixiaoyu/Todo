{
  "name": "lumina",
  "version": "1.0.0-beta.9",
  "description": "Lumina (简思) - An AI-driven personal todo system with extreme interactive experience and rigorous engineering practices.",
  "license": "AGPL-3.0-only",
  "author": "牧云 (Mu Yun) <yunmucoder@163.com>",
  "homepage": "https://github.com/xixixiaoyu/lumina",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xixixiaoyu/lumina.git"
  },
  "bugs": {
    "url": "https://github.com/xixixiaoyu/lumina/issues"
  },
  "keywords": [
    "todo",
    "ai",
    "mcp",
    "nestjs",
    "vue",
    "wails",
    "capacitor",
    "monorepo",
    "productivity"
  ],
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@lumina/shared --filter=@lumina/backend --filter=@lumina/frontend",
    "dev:backend": "turbo run dev --filter=@lumina/shared --filter=@lumina/backend",
    "dev:frontend": "turbo run dev --filter=@lumina/shared --filter=@lumina/frontend",
    "dev:all": "turbo run dev",
    "build": "turbo run build",
    "build:ci": "turbo run build --concurrency=50%",
    "type-check": "turbo run type-check --concurrency=2",
    "type-check:watch": "turbo run type-check:watch --filter=@lumina/shared --filter=@lumina/backend --filter=@lumina/frontend",
    "lint": "pnpm exec oxlint --config .oxlintrc.json",
    "lint:eslint": "turbo run lint",
    "lint:eslint:strict": "turbo run lint:strict",
    "lint:strict": "pnpm exec oxlint --config .oxlintrc.json --deny-warnings",
    "lint:fix": "pnpm exec oxlint --config .oxlintrc.json --fix",
    "test": "turbo run test",
    "ci:check": "pnpm exec oxfmt --check && pnpm exec oxlint --config .oxlintrc.json && bun scripts/check-boundaries.js && knip --include files,dependencies,duplicates --no-exit-code && turbo run type-check --filter=@lumina/backend --filter=@lumina/frontend --filter=@lumina/sidecar --filter=@lumina/shared --concurrency=50%",
    "ci:test": "turbo run test --concurrency=50%",
    "ci:all": "pnpm ci:check && pnpm ci:test && pnpm security-audit",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "format": "pnpm exec oxfmt --write",
    "format:check": "pnpm exec oxfmt --check",
    "security-audit": "bun scripts/security-audit.js",
    "knip": "knip",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @lumina/backend prisma:generate",
    "db:push": "pnpm --filter @lumina/backend prisma:push",
    "db:migrate": "pnpm --filter @lumina/backend prisma:migrate",
    "db:studio": "pnpm --filter @lumina/backend prisma:studio",
    "prepare": "husky",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:clean": "docker compose down -v --rmi local",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:restart": "docker compose -f docker-compose.dev.yml restart backend frontend",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "docker:dev:ps": "docker compose -f docker-compose.dev.yml ps",
    "docker:dev:clean": "docker compose -f docker-compose.dev.yml down -v --rmi local",
    "docker:prune": "docker system prune -f --volumes",
    "wails:dev": "cd apps/wails && wails dev",
    "wails:build": "pnpm sidecar:build && turbo run build:wails --filter=@lumina/frontend && cd apps/wails && wails build -s -trimpath -clean -ldflags \"-s -w\" && ./scripts/assemble-sidecar.sh",
    "wails:build:win": "pnpm sidecar:build && turbo run build:wails --filter=@lumina/frontend && cd apps/wails && wails build -s -trimpath -clean -ldflags \"-s -w\" -platform windows/amd64 && pwsh ./scripts/assemble-sidecar.ps1",
    "wails:build:linux": "pnpm sidecar:build && turbo run build:wails --filter=@lumina/frontend && cd apps/wails && wails build -s -trimpath -clean -ldflags \"-s -w\" -platform linux/amd64 && ./scripts/assemble-sidecar.sh",
    "wails:sign:mac": "cd apps/wails && ./scripts/sign-mac.sh",
    "wails:sign:win": "pwsh -File apps/wails/scripts/package-windows.ps1 -Sign",
    "wails:dmg": "cd apps/wails && ./scripts/create-dmg.sh",
    "wails:appimage": "cd apps/wails && ./scripts/create-appimage.sh",
    "wails:deb": "cd apps/wails && ./scripts/create-deb.sh",
    "wails:package:win": "pwsh -File apps/wails/scripts/package-windows.ps1",
    "wails:kill": "./scripts/close-app.sh",
    "wails:install": "./scripts/deploy-app.sh",
    "wails:deploy": "pnpm wails:kill && pnpm wails:build && pnpm wails:sign:mac && pnpm wails:install",
    "wails:release:mac": "pnpm wails:kill && pnpm wails:build && pnpm wails:dmg",
    "wails:release:win": "pnpm wails:build:win && pnpm wails:package:win",
    "wails:release:linux": "pnpm wails:build:linux && pnpm wails:appimage && pnpm wails:deb",
    "sidecar:build": "pnpm --filter @lumina/shared build && pnpm --filter @lumina/sidecar build",
    "sidecar:dev": "pnpm --filter @lumina/shared build && pnpm --filter @lumina/sidecar dev",
    "tag:refresh": "./scripts/refresh-tag.sh",
    "pm2:backend": "pnpm --filter @lumina/backend pm2:start"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@typescript/native-preview": "7.0.0-dev.20260421.2",
    "@vitest/coverage-v8": "4.1.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-vue": "10.6.2",
    "husky": "9.1.7",
    "knip": "6.12.2",
    "lint-staged": "16.2.7",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "prettier": "3.7.4",
    "turbo": "2.7.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.1",
    "vitest": "4.1.0"
  },
  "lint-staged": {
    "**/*.{ts,tsx,vue,mts,cts}": [
      "oxlint --config .oxlintrc.json --fix",
      "oxfmt --write"
    ],
    "**/*.{json,css,scss,html,yml,yaml,md}": [
      "oxfmt --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "nodemailer": "7.0.12",
      "glob": "10.5.0",
      "lodash": "4.17.23",
      "lodash-es": "4.17.23",
      "qs": "6.15.0",
      "tar": "7.5.3",
      "diff": "8.0.3",
      "hono": "4.12.8",
      "@hono/node-server": "1.19.11",
      "@fastify/middie": "9.3.1",
      "express-rate-limit": "8.3.1",
      "file-type": "21.3.2",
      "mailparser": "3.9.4",
      "fastify": "5.8.2",
      "fast-xml-parser": "5.5.9",
      "effect": "3.20.1",
      "liquidjs": "10.25.0",
      "dompurify": "3.3.3",
      "underscore": "1.13.8",
      "socket.io-parser": "4.2.6",
      "minimatch@>=5.0.0 <6.0.0": "5.1.8",
      "minimatch@>=9.0.0 <10.0.0": "9.0.7",
      "katex": "0.16.21"
    }
  }
}

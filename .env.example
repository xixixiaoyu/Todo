# ==============================================================================
# 应用环境配置模板 (Environment Variables Template)
# ==============================================================================
# 复制此文件为 .env 并根据实际环境修改变量
# Copy this file to .env and modify variables according to your environment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 核心基础配置 (CORE - Required)
# ------------------------------------------------------------------------------
NODE_ENV=development                  # development | production | test
PORT=3000                             # 后端服务端口
FRONTEND_URL=http://localhost:5173    # 前端访问地址 (生产环境设为你的公网 IP 或域名)

# ------------------------------------------------------------------------------
# 2. 数据库配置 (DATABASE - Required)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres            # 生产环境务必修改此密码
POSTGRES_DB=lumina
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public"

# ------------------------------------------------------------------------------
# 3. 缓存与队列 (REDIS - Required)
# ------------------------------------------------------------------------------
REDIS_HOST=redis                      # Docker 部署内部网络名为 redis，本地运行设为 localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password    # 务必修改此密码
REDIS_DB=0
REDIS_KEY_PREFIX=lumina:
REDIS_DEFAULT_TTL=300               # 默认缓存过期时间 (秒)

# ------------------------------------------------------------------------------
# 4. 安全与认证 (SECURITY - Required)
# ------------------------------------------------------------------------------
# 生产环境下必须修改以下密钥！可以使用命令生成: openssl rand -base64 32
JWT_SECRET=your-super-long-random-secret-key
JWT_REFRESH_SECRET=your-super-long-random-refresh-key

JWT_ACCESS_EXPIRES_IN=900           # 访问令牌过期时间 (秒)，默认 15 分钟
JWT_REFRESH_EXPIRES_IN=604800       # 刷新令牌过期时间 (秒)，支持数字或字符串 (如 7d)
RESET_PASSWORD_EXPIRES_IN=3600      # 密码重置令牌过期时间 (秒)，默认 1 小时

# ------------------------------------------------------------------------------
# 5. 可选：外部服务 (OPTIONAL - External Services)
# ------------------------------------------------------------------------------
# 邮件服务 (Mail - SMTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false                   # true 为 465 端口, false 为 587 端口
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="No Reply" <noreply@example.com>

# 云存储配置 (Storage - S3/OSS/MinIO)
S3_BUCKET=lumina-uploads
S3_REGION=us-east-1
S3_ENDPOINT=                        # 可选，用于 OSS/MinIO，例如: https://oss-cn-hangzhou.aliyuncs.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 6. 进阶：性能与调试 (ADVANCED - Performance & Debug)
# ------------------------------------------------------------------------------
# 日志级别: trace, debug, info, warn, error, fatal, silent
LOG_LEVEL=debug

# CORS 允许的来源 (生产环境设为你的公网 IP 或域名，多个用逗号分隔)
CORS_ORIGIN=http://localhost:5173

# 速率限制 (Rate Limiting)
THROTTLE_SHORT_TTL=1000
THROTTLE_SHORT_LIMIT=20
THROTTLE_MEDIUM_TTL=10000
THROTTLE_MEDIUM_LIMIT=100
THROTTLE_LONG_TTL=60000
THROTTLE_LONG_LIMIT=300

# 文件上传限制
UPLOAD_MAX_SIZE=10485760            # 最大文件大小 (字节)，默认 10MB
UPLOAD_MAX_FILES=10                 # 最大文件数量

# ------------------------------------------------------------------------------
# 8. 前端高级配置 (FRONTEND - Vite Overrides)
# ------------------------------------------------------------------------------
# 注意：以下变量仅在需要覆盖默认逻辑时设置
# VITE_API_BASE_URL=                  # API 基础路径，默认自动推断
# VITE_PROXY_TARGET=http://localhost:3000 # 开发环境代理目标，默认 localhost:3000
# VITE_BASE_URL=/                     # 前端部署的 Base Path (例如: /lumina/)
# VITE_AUTH_REFRESH_RETRY_DELAY_MS=300  # refresh 重试间隔 (毫秒)
# VITE_AUTH_REFRESH_MAX_ATTEMPTS=2      # refresh 最大尝试次数（含首次）

# AI 配置 (核心功能，建议保留)
VITE_AI_API_URL=https://api.deepseek.com
VITE_AI_API_KEY=
VITE_AI_MODEL=deepseek-chat

# ------------------------------------------------------------------------------
# 9. 部署与自动化 (DEPLOYMENT)
# ------------------------------------------------------------------------------
IMAGE_TAG=latest                    # Docker 镜像标签

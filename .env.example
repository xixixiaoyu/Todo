# ==============================================================================
# 应用环境配置模板 (Environment Variables Template)
# ==============================================================================
# 复制此文件为 .env 并根据实际环境修改变量
# Copy this file to .env and modify variables according to your environment
# ==============================================================================

# ------------------------------------------------------------------------------
# 基础配置 (Basic Configuration)
# ------------------------------------------------------------------------------
NODE_ENV=development                # development, production, test
PORT=3000                           # 后端服务端口
FRONTEND_URL=http://localhost:5173  # 前端服务地址 (本地开发通常为 5173)

# ------------------------------------------------------------------------------
# 数据库配置 (Database - SQLite or PostgreSQL)
# ------------------------------------------------------------------------------
# 切换数据库类型请运行: pnpm --filter @my-app/backend db:switch <sqlite|postgres>

# SQLite 模式 (默认推荐用于本地开发)
DATABASE_URL="file:./dev.db"

# PostgreSQL 模式 (用于生产或高级特性)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=myapp
# DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?schema=public"

# ------------------------------------------------------------------------------
# 缓存与队列 (Redis - BullMQ & Cache)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost                # 本地开发用 localhost，Docker 部署用 redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=app:
REDIS_DEFAULT_TTL=300               # 默认缓存过期时间 (秒)

# ------------------------------------------------------------------------------
# 安全与认证 (Security & Authentication)
# ------------------------------------------------------------------------------
# 注意：生产环境下必须修改以下密钥！
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-jwt-key-change-in-production

JWT_ACCESS_EXPIRES_IN=900           # 访问令牌过期时间 (秒)，默认 15 分钟
JWT_REFRESH_EXPIRES_IN=604800       # 刷新令牌过期时间 (秒)，支持数字或字符串 (如 7d)
RESET_PASSWORD_EXPIRES_IN=3600      # 密码重置令牌过期时间 (秒)，默认 1 小时

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# WebAuthn / Passkeys
RP_ID=localhost
APP_NAME="简思"

# ------------------------------------------------------------------------------
# 日志与跨域 (Logging & CORS)
# ------------------------------------------------------------------------------
# 日志级别: trace, debug, info, warn, error, fatal, silent
LOG_LEVEL=debug

# CORS 允许的来源 (多个来源用逗号分隔)
# 本地开发: http://localhost:5173
# Docker 生产环境: http://localhost:80 (或其他实际访问域名)
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 速率限制 (Rate Limiting)
# ------------------------------------------------------------------------------
THROTTLE_SHORT_TTL=1000             # 短期限制时间窗口 (毫秒)
THROTTLE_SHORT_LIMIT=3              # 短期限制次数
THROTTLE_MEDIUM_TTL=10000           # 中期限制时间窗口 (毫秒)
THROTTLE_MEDIUM_LIMIT=20            # 中期限制次数
THROTTLE_LONG_TTL=60000             # 长期限制时间窗口 (毫秒)
THROTTLE_LONG_LIMIT=100             # 长期限制次数

# ------------------------------------------------------------------------------
# 邮件服务 (Mail - SMTP)
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false                   # true 为 465 端口, false 为 587 端口
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="No Reply" <noreply@example.com>

# ------------------------------------------------------------------------------
# 云存储配置 (Storage - S3/OSS/MinIO)
# ------------------------------------------------------------------------------
S3_BUCKET=my-app-uploads
S3_REGION=us-east-1
S3_ENDPOINT=                        # 可选，用于 OSS/MinIO，例如: https://oss-cn-hangzhou.aliyuncs.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# 文件上传限制
UPLOAD_MAX_SIZE=10485760            # 最大文件大小 (字节)，默认 10MB
UPLOAD_MAX_FILES=10                 # 最大文件数量

# ------------------------------------------------------------------------------
# 前端配置 (Frontend - Vite)
# ------------------------------------------------------------------------------
# 注意：前端变量必须以 VITE_ 开头才能被 Vite 识别
VITE_API_BASE_URL=http://localhost:3000/api
VITE_AI_API_URL=https://api.deepseek.com
VITE_AI_API_KEY=
VITE_AI_MODEL=deepseek-chat

# ==============================================================================
# 应用环境配置模板（短版：日常必填）
# ==============================================================================
# 复制此文件为 .env 并修改以下核心项即可。
# 如需完整配置项（SMTP/S3/部署高级参数等），请参考 .env.full.example。

# 后端启动核心
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lumina?schema=public
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
CORS_ORIGIN=http://localhost:5173

# 生产部署必需（deploy.sh / docker-compose 会校验）
POSTGRES_PASSWORD=postgres
REDIS_PASSWORD=dev-redis-password
